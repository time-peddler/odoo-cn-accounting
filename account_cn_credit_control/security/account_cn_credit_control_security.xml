<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_cn_credit_limit_override" model="res.groups">
        <field name="name">信用超限审批人</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="comment">客户超出信用额度时，仍可确认销售订单/过账发票。</field>
    </record>

    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_cn_credit_limit_override'))]"/>
    </record>

</odoo>
