<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_line_tree_cn_cash_flow_item" model="ir.ui.view">
        <field name="name">account.move.line.list.cn.cash.flow.item</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="tax_tag_ids" position="after">
                <field name="cn_cash_flow_item_id"
                       optional="hide"
                       invisible="account_type != 'asset_cash'"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>

</odoo>
