        <record id="bs_trading_fin_liabilities" model="account.cn.statement.line">
            <field name="statement_id" ref="statement_balance_sheet"/>
            <field name="parent_id" ref="bs_sec_current_liabilities"/>
            <field name="sequence">20</field>
            <field name="code">TRADING_FIN_LIABILITIES</field>
            <field name="name">交易性金融负债</field>
            <field name="line_type">detail</field>
            <field name="account_code_prefixes">2101,2112</field>
            <field name="balance_side">credit</field>
        </record>
        <record id="bs_notes_payable" model="account.cn.statement.line">
            <field name="statement_id" ref="statement_balance_sheet"/>
            <field name="parent_id" ref="bs_sec_current_liabilities"/>
            <field name="sequence">30</field>
            <field name="code">NOTES_PAYABLE</field>
            <field name="name">应付票据</field>
            <field name="line_type">detail</field>
            <field name="account_code_prefixes">2201</field>
            <field name="balance_side">credit</field>
        </record>
        <record id="bs_accounts_payable" model="account.cn.statement.line">
            <field name="statement_id" ref="statement_balance_sheet"/>
            <field name="parent_id" ref="bs_sec_current_liabilities"/>
            <field name="sequence">40</field>
            <field name="code">ACCOUNTS_PAYABLE</field>
            <field name="name">应付账款</field>
            <field name="line_type">detail</field>
            <field name="account_code_prefixes">2202</field>
            <field name="balance_side">credit</field>
        </record>
        <record id="bs_receipts_in_advance" model="account.cn.statement.line">
            <field name="statement_id" ref="statement_balance_sheet"/>
            <field name="parent_id" ref="bs_sec_current_liabilities"/>
            <field name="sequence">50</field>
            <field name="code">RECEIPTS_IN_ADVANCE</field>
            <field name="name">预收账款</field>
            <field name="line_type">detail</field>
            <field name="account_code_prefixes">2203</field>
            <field name="balance_side">credit</field>
        </record>
        <record id="bs_contract_liabilities" model="account.cn.statement.line">
            <field name="statement_id" ref="statement_balance_sheet"/>
            <field name="parent_id" ref="bs_sec_current_liabilities"/>
            <field name="sequence">60</field>
            <field name="code">CONTRACT_LIABILITIES</field>
            <field name="name">合同负债</field>
            <field name="line_type">detail</field>
            <field name="account_code_prefixes">2204</field>
            <field name="balance_side">credit</field>
        </record>
        <record id="bs_employee_benefits_payable" model="account.cn.statement.line">
            <field name="statement_id" ref="statement_balance_sheet"/>
            <field name="parent_id" ref="bs_sec_current_liabilities"/>
            <field name="sequence">70</field>
            <field name="code">EMPLOYEE_BENEFITS_PAYABLE</field>
            <field name="name">应付职工薪酬</field>
