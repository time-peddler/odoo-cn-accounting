<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_cn_aging_report_receivable" model="ir.actions.client">
        <field name="name">客户账龄分析表</field>
        <field name="tag">account_cn_aging_report</field>
        <field name="params" eval="{'account_type': 'asset_receivable'}"/>
    </record>

    <record id="action_cn_aging_report_payable" model="ir.actions.client">
        <field name="name">供应商账龄分析表</field>
        <field name="tag">account_cn_aging_report</field>
        <field name="params" eval="{'account_type': 'liability_payable'}"/>
    </record>

    <menuitem id="menu_cn_aging_report_receivable"
              name="客户账龄分析表"
              parent="account.account_reports_partners_reports_menu"
              action="action_cn_aging_report_receivable"
              sequence="1"/>
    <menuitem id="menu_cn_aging_report_payable"
              name="供应商账龄分析表"
              parent="account.account_reports_partners_reports_menu"
              action="action_cn_aging_report_payable"
              sequence="2"/>

</odoo>
