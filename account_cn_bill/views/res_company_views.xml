<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_cn_bill" model="ir.ui.view">
        <field name="name">res.company.form.cn.bill</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <page name="general_info" position="after">
                <page string="票据管理" name="cn_bill">
                    <group>
                        <field name="cn_notes_receivable_account_id" options="{'no_create': True}"/>
                        <field name="cn_notes_payable_account_id" options="{'no_create': True}"/>
                        <field name="cn_bill_interest_expense_account_id" options="{'no_create': True}"/>
                        <field name="cn_bill_financing_account_id" options="{'no_create': True}"/>
                    </group>
                </page>
            </page>
        </field>
    </record>

</odoo>
