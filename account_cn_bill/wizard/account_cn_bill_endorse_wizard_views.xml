<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_cn_bill_endorse_wizard_form" model="ir.ui.view">
        <field name="name">account.cn.bill.endorse.wizard.form</field>
        <field name="model">account.cn.bill.endorse.wizard</field>
        <field name="arch" type="xml">
            <form string="票据背书转让">
                <group>
                    <field name="bill_id" invisible="1"/>
                    <field name="endorse_date"/>
                    <field name="partner_id"/>
                    <field name="invoice_ids"
                           domain="[('partner_id', '=', partner_id), ('state', '=', 'posted'), ('payment_state', 'not in', ('paid', 'in_payment'))]"
                           widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="确认背书转让" class="btn-primary"/>
                    <button string="取消" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
