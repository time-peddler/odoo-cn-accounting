<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_cn_asset_category_list" model="ir.ui.view">
        <field name="name">account.cn.asset.category.list</field>
        <field name="model">account.cn.asset.category</field>
        <field name="arch" type="xml">
            <list string="固定资产类别">
                <field name="code"/>
                <field name="name"/>
                <field name="method"/>
                <field name="default_useful_life_years"/>
                <field name="default_salvage_rate"/>
                <field name="fixed_asset_account_id"/>
                <field name="depreciation_account_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_account_cn_asset_category_form" model="ir.ui.view">
        <field name="name">account.cn.asset.category.form</field>
        <field name="model">account.cn.asset.category</field>
        <field name="arch" type="xml">
            <form string="固定资产类别">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="method"/>
                            <field name="default_useful_life_years"/>
                            <field name="default_salvage_rate"/>
                            <field name="company_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="fixed_asset_account_id"/>
                            <field name="depreciation_account_id"
                                   domain="[('account_type', '=', 'asset_fixed'), ('id', '!=', fixed_asset_account_id)]"/>
                            <field name="depreciation_expense_account_id"/>
                            <field name="disposal_account_id"
                                   domain="[('account_type', '=', 'asset_fixed'),
                                            ('id', 'not in', [fixed_asset_account_id, depreciation_account_id])]"/>
                            <field name="impairment_account_id"
                                   domain="[('account_type', '=', 'asset_fixed'),
                                            ('id', 'not in', [fixed_asset_account_id, depreciation_account_id, disposal_account_id])]"/>
                            <field name="journal_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_cn_asset_category" model="ir.actions.act_window">
        <field name="name">固定资产类别</field>
        <field name="res_model">account.cn.asset.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
