<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_cn_asset_inventory_count_list" model="ir.ui.view">
        <field name="name">account.cn.asset.inventory.count.list</field>
        <field name="model">account.cn.asset.inventory.count</field>
        <field name="arch" type="xml">
            <list string="固定资产盘点盈亏">
                <field name="count_date"/>
                <field name="count_type" widget="badge"/>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="category_id"/>
                <field name="estimated_value"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_account_cn_asset_inventory_count_form" model="ir.ui.view">
        <field name="name">account.cn.asset.inventory.count.form</field>
        <field name="model">account.cn.asset.inventory.count</field>
        <field name="arch" type="xml">
            <form string="固定资产盘点盈亏">
                <header>
                    <button name="action_post_pending" type="object" string="挂账"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_post_disposition" type="object" string="转销"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,done"/>
                </header>
                <group>
                    <group>
                        <field name="count_type"/>
                        <field name="count_date"/>
                        <field name="asset_id" invisible="count_type != 'deficit'"
                               required="count_type == 'deficit'"/>
                        <field name="category_id"/>
                        <field name="name"/>
                        <field name="company_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="estimated_value"/>
                        <field name="disposition_type" invisible="state == 'draft'"/>
                        <field name="move_id" readonly="1"/>
                        <field name="disposition_move_id" readonly="1"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="action_account_cn_asset_inventory_count" model="ir.actions.act_window">
        <field name="name">固定资产盘点盈亏</field>
        <field name="res_model">account.cn.asset.inventory.count</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
