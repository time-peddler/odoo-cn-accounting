<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_cn_asset_impairment_list" model="ir.ui.view">
        <field name="name">account.cn.asset.impairment.list</field>
        <field name="model">account.cn.asset.impairment</field>
        <field name="arch" type="xml">
            <list string="固定资产减值记录">
                <field name="date"/>
                <field name="asset_id"/>
                <field name="amount"/>
                <field name="reason"/>
                <field name="move_id"/>
                <field name="state" widget="badge"/>
                <button name="action_post" type="object" string="过账" invisible="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="view_account_cn_asset_impairment_form" model="ir.ui.view">
        <field name="name">account.cn.asset.impairment.form</field>
        <field name="model">account.cn.asset.impairment</field>
        <field name="arch" type="xml">
            <form string="固定资产减值">
                <header>
                    <button name="action_post" type="object" string="过账"
                            class="btn-primary" invisible="state == 'posted'"/>
                </header>
                <group>
                    <field name="asset_id"/>
                    <field name="date"/>
                    <field name="amount"/>
                    <field name="reason"/>
                    <field name="move_id" readonly="1"/>
                    <field name="state" widget="badge"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_account_cn_asset_impairment" model="ir.actions.act_window">
        <field name="name">固定资产减值</field>
        <field name="res_model">account.cn.asset.impairment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
