<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_cn_asset_depreciation_wizard_form" model="ir.ui.view">
        <field name="name">account.cn.asset.depreciation.wizard.form</field>
        <field name="model">account.cn.asset.depreciation.wizard</field>
        <field name="arch" type="xml">
            <form string="批量计提折旧">
                <group>
                    <field name="date"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="asset_id" readonly="1"/>
                        <field name="method" readonly="1"/>
                        <field name="workload_amount"/>
                        <field name="preview_amount"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="确认计提" class="btn-primary"/>
                    <button string="取消" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_cn_asset_depreciation_wizard" model="ir.actions.act_window">
        <field name="name">批量计提折旧</field>
        <field name="res_model">account.cn.asset.depreciation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
